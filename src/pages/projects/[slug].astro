---
import Site from '../../components/Site.astro';
import ConceptArt from '../../components/ConceptArt.astro';
import {projects} from '../../lib/projects';
export function getStaticPaths(){return projects.map(project=>({params:{slug:project.slug},props:{project}}));}
const {project:p}=Astro.props;
---
<Site title={`${p.title} | Scornis Innovation Project`} description={p.description}>
<div class="wrap"><section class="page-intro"><a class="eyebrow" href="/innovations">← All innovations</a><p class="eyebrow">{p.category}</p><h1>{p.title}</h1><h2>{p.tagline}</h2><p>{p.intro}</p><p class="credits">Founded by {p.founder}</p><span class="status">◌ {p.status}</span></section><ConceptArt kind={p.slug} label={`${p.name}: original conceptual illustration, not a validated system`}/>
<section class="section split"><div><p class="eyebrow">01 / Context</p><h2>{p.slug==='learn-o-ai'||p.slug==='safaiera'||p.slug==='astrovita'?'The challenge':p.slug==='vita-mini'?'The research challenge':'The problem'}</h2><p>{p.problem}</p></div><div><p class="eyebrow">02 / Direction</p><h2>{p.slug==='spacexbot'?'Our vision':'Proposed solution'}</h2><p>{p.solution??p.intro}</p></div></section>
<section><p class="eyebrow">03 / System thinking</p><h2>{p.slug==='spacexbot'?'Core workflow':'Conceptual workflow'}</h2><div class="process">{p.flow.map((s,i)=><span>{s}{i<p.flow.length-1?' →':''}</span>)}</div><p class="small">A proposed development workflow, not evidence of completed milestones or operational capabilities.</p>{p.steps&&<ol class="list">{p.steps.map(s=><li>{s}</li>)}</ol>}</section>
<section class="section split"><div><p class="eyebrow">04 / Exploration</p><h2>{p.slug==='vita-mini'?'Research areas':p.slug==='spacexbot'?'Proposed design principles':'Proposed capabilities'}</h2><p>Design goals and research directions. Implemented capabilities are listed only when independently verified; none have been supplied for this overview.</p><ul class="list">{p.features.map(s=><li>{s}</li>)}</ul></div><div><p class="eyebrow">05 / Next steps</p><h2>Development roadmap</h2><ol class="list">{p.roadmap.map((s,i)=><li>{i+1}. {s}</li>)}</ol></div></section>
{p.extra&&<section class="section"><h2>{p.extraTitle}</h2><p>{p.extra}</p></section>}
<section class="notice"><h3>Current development stage & responsible use</h3><p>{p.note}</p></section>
<section class="section"><h2>Research questions & project notes</h2><p>Explore the concept’s scope, safety considerations, and next research priorities.</p><a class="button" href="/updates">Read project notes ↗</a></section>
<section class="cta"><p class="eyebrow">Explore together</p><h2>Collaboration opportunities</h2><p>We welcome conversations with {p.collaboration}</p><a class="button primary" href="/contact">{p.button} ↗</a></section></div>
</Site>