import Site from '../components/Site.astro';
import ConceptArt from '../components/ConceptArt.astro';
const values=[['Curiosity','Ask better questions and investigate unfamiliar possibilities.'],['Integrity','Communicate evidence, limitations, and development stages honestly.'],['Experimentation','Test ideas carefully and learn from results.'],['Collaboration','Bring different perspectives together with shared accountability.'],['Responsible Innovation','Consider safety, privacy, and human impact from the beginning.'],['Continuous Learning','Refine our understanding as new evidence emerges.']];
