---
import Site from '../components/Site.astro';
import KleapForm from '@/components/KleapForm';
---
<Site title="Contact Scornis | Research & Technology Collaboration" description="Connect with Scornis for technical mentorship, research collaboration, simulation, prototyping, academic partnerships, testing, and responsible innovation exploration."><div class="wrap"><section class="page-intro"><p class="eyebrow">Good questions start great conversations.</p><h1>Let's Build What Comes Next.</h1><p>We welcome thoughtful conversations with engineers, researchers, mentors, institutions, and organizations interested in exploring our projects.</p></section><section class="split section"><div><h2>Collaboration opportunities</h2><ul class="list">{['Technical mentorship','Research collaboration','Simulation and prototyping','Academic partnerships','Testing and validation','Incubation and innovation programs','Industry problem exploration'].map(s=><li>{s}</li>)}</ul><p class="small">Official email, LinkedIn, and external product links have not been supplied. Please use this contact form to reach Scornis.</p><div class="notice"><p>Profile changes and photograph approvals may also be requested here. Share a link to proposed media in your message; do not include sensitive personal or medical information.</p></div></div><div><KleapForm client:load formId="contact" title="Contact Scornis" fields={[{name:'name',label:'Full name',type:'text',required:true},{name:'email',label:'Professional email',type:'email',required:true},{name:'organization',label:'Organization (optional)',type:'text'},{name:'interest',label:'Area of interest',type:'select',required:true,options:['Technical mentorship','Research collaboration','Simulation and prototyping','Academic partnerships','Testing and validation','Incubation and innovation programs','Industry problem exploration','Profile update or photograph approval','General inquiry']},{name:'project',label:'Project of interest',type:'select',required:true,options:['General / Scornis','SpaceXbot','Hanora AI','Learn O AI','Safaiera','Vita Mini','AstroVita']},{name:'message',label:'Message',type:'textarea',required:true},{name:'consent',label:'I consent to Scornis using these details to respond to my inquiry, as described in the privacy notice.',type:'checkbox',required:true}]} submitText="Send collaboration inquiry" successMessage="Thank you. Your inquiry has been sent to Scornis."/><p class="small">Your inquiry is delivered to the site owner and stored in the inquiry dashboard. <a class="accent" href="/privacy">Read our privacy notice.</a></p></div></section></div></Site>