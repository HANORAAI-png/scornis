---
import Site from '../components/Site.astro';
const photos=['/uploads/keerthi.jpg','/uploads/whatsapp-image-2026-10-11-at-11-25-59-am.jpg','https://assets.kleap.io/115373/images/1791689016549-WhatsApp_Image_2026-10-11_at_8.38.36_AM.jpeg','/uploads/deepthi.jpg','/uploads/tharani.jpg','https://assets.kleap.io/115373/images/1791689019039-WhatsApp_Image_2026-10-10_at_1.18.33_PM.jpeg'];
const team=[{name:'Keerthi Vuttipalli',role:'Founder of',credits:'SpaceXbot · Hanora AI · Learn O AI · Safaiera · Vita Mini',bio:' Leading the overall innovation vision and the development of multiple project concepts across aerospace robotics, AI marketing, education, food safety, and emerging healthcare technology.'},{name:'Shravya  Dubakunta',role:'Technology & Engineering Lead at SCORNIS.',credits:'Founder of AstroVita.',bio:'Leads technology and engineering coordination within Scornis and independently leads AstroVita, an AI-assisted astronaut health-monitoring concept.'},{name:'Divya Suthoju',role:'Head of Research & Development AT SCORNIS',bio:'Leads research and development activities, supporting the investigation, evaluation, and refinement of Scornis innovation concepts.'},{name:'Deepthi Ragulakollu',role:'Co-Head of Research & Development AT SCORNIS.',bio:'Supports research and development activities, helping investigate technical approaches and refine emerging project concepts.'},{name:'Tharani Macharla',role:'Business & Development Manager AT SCORNIS.',bio:'Supports business development, opportunity exploration, project positioning, and collaboration planning across the Scornis portfolio.'},{name:'Nikitha Dharavath',role:'Content Manager AT SCORNIS.',bio:'Supports content planning, project communication, storytelling, and the presentation of Scornis innovations to wider audiences.'}];
---
<Site title="Our Team | The Student Innovators Behind Scornis" description="Meet Scornis founder Keerthi Vuttipalli, AstroVita founder Shravya, and team members Divya, Deepthi, Tharani, and Nikitha with their exact roles and project credits."><div class="wrap"><section class="page-intro"><p class="eyebrow">Connected minds. Shared ambition.</p><h1>The People Behind Scornis.</h1><p>Scornis brings together student innovators exploring ideas across technology and research. We value initiative, collaboration, accountability, and continuous learning.</p></section><div class="grid">{team.map((t,i)=><article class="card"><img src={photos[i]} alt={`Portrait of ${t.name}`} loading="lazy" style="display:block;width:100%;height:auto;border-radius:16px 16px 0 0" /><div class="card-body"><h2 style="font-size:1.35rem">{t.name}</h2><span class="eyebrow">{t.role}</span>{t.credits&&<p class="credits">{t.credits}</p>}<p>{t.bio}</p>{t.name==='Shravya'&&<a class="project-link" href="/projects/astrovita">Explore AstroVita ↗</a>}</div></article>)}</div></div></Site>