---
import Base from '../layouts/Base.astro';
import '../styles/scornis.css';
const {title,description}=Astro.props;
const links=[['/','Home'],['/about','About Scornis'],['/innovations','Innovations'],['/team','Our Team'],['/updates','Updates'],['/contact','Contact']];
---
<Base title={title} description={description}>
<a class="skip" href="#main">Skip to content</a>
<header class="header wrap"><a class="wordmark" href="/" aria-label="Scornis home"><svg width="37" height="37" viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="M20 3 36 12v16L20 37 4 28V12Z" stroke="currentColor"/><ellipse cx="20" cy="20" rx="18" ry="7" transform="rotate(-38 20 20)" stroke="currentColor"/><path d="m13 25 7-14 7 14-7-4Z" fill="currentColor"/></svg>SCORNIS</a><nav class="desktop" aria-label="Main navigation">{links.map(([url,label])=><a href={url} aria-current={Astro.url.pathname===url?'page':undefined}>{label}</a>)}</nav><details class="mobile"><summary aria-label="Open navigation">Menu ☰</summary><nav aria-label="Mobile navigation">{links.map(([url,label])=><a href={url}>{label}</a>)}</nav></details></header>
<main id="main"><slot/></main>
<footer class="wrap"><div class="footer-top"><div><a class="wordmark" href="/">SCORNIS</a><p>Ideas Beyond Boundaries.<br/>Innovation Without Limits.</p></div><nav aria-label="Footer navigation">{links.map(([url,label])=><a href={url}>{label}</a>)}<a href="/privacy">Privacy notice</a></nav></div><div class="footer-bottom"><span>© {new Date().getFullYear()} SCORNIS</span><span>Student-led. Research-driven. Responsibly ambitious.</span></div><p class="small">Our portfolio includes early-stage concepts and proposed capabilities, not validated technologies. Verified social profiles will be linked when supplied.</p></footer>
</Base>